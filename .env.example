# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side admin console passcode.
ADMIN_PASSCODE=

# AWS Integration (Server-side only; configure secrets in AI Studio Secrets)
AWS_REGION=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Supabase Integration (Server-side only)
SUPABASE_URL=https://jpllpvfunpsqexnvjgdt.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Self-Hosted WordPress Bridge (Optional server-side credentials)
WORDPRESS_SITE_URL=
WORDPRESS_APP_USER=
WORDPRESS_APP_PASSWORD=
