# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / PORT / NODE_ENV: Hosting URL and Express server runtime
APP_URL="MY_APP_URL"
PORT=3000

# ADMIN_PASSCODE / SESSION_SECRET: Optional server-side admin passcode and HMAC signing secret
ADMIN_PASSCODE=
SESSION_SECRET=

# AWS Integration (Server-side secrets + optional external S3 upload API URL)
AWS_REGION=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
VITE_S3_API_URL=

# Supabase Integration (Server-side secrets + optional public VITE_ anon key for static builds)
SUPABASE_URL=https://jpllpvfunpsqexnvjgdt.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://jpllpvfunpsqexnvjgdt.supabase.co
VITE_SUPABASE_ANON_KEY=

# Self-Hosted WordPress Bridge (Optional server-side credentials)
WORDPRESS_SITE_URL=
WORDPRESS_APP_USER=
WORDPRESS_APP_PASSWORD=

# Google Cloud Integration (Server-side only; configure secrets in AI Studio Secrets)
GCP_PROJECT_ID=
GCP_REGION=
GCS_BUCKET=
GCP_HOSTING_DOMAIN=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
GCP_SERVICE_ACCOUNT_JSON=
